# Flirta / GarbaJodi Production Environment Variables

# Application Environment
NODE_ENV=production
PORT=3030
BASE_URL=https://flirta.network

# Security: Generate a strong random key (e.g., openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key

# Admin Seed Security (Set in production for your initial admin account)
ADMIN_EMAIL=admin@flirta.in
ADMIN_PASSWORD=replace_with_a_strong_admin_password_16_chars

# Demo / Test Accounts Guard
# Set to 'false' in production. Demo login buttons and routes are strictly disabled.
ENABLE_DEMO_LOGIN=false

# Database
DB_PATH=./garbajodi.db

# Cloudflare Turnstile (Bot & Abuse Protection on Signup)
# Obtain from Cloudflare Dashboard > Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google OAuth 2.0 / Google Identity Services (GIS)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized JavaScript origin: https://flirta.network
# Authorized redirect URI: https://flirta.network/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PayU India Payment Gateway
# In development/test mode, you can use PayU test credentials:
# PAYU_ENV=test
# PAYU_MERCHANT_KEY=gtKFFx
# PAYU_MERCHANT_SALT=eCwWELxi
#
# FOR PRODUCTION / LIVE DEPLOYMENT:
# 1. Login to your PayU Merchant Dashboard (https://onboarding.payu.in)
# 2. Go to Settings > Key Salt details
# 3. Copy your Production Merchant Key and Salt
# 4. Set PAYU_ENV=live
PAYU_ENV=live
PAYU_MERCHANT_KEY=your_production_payu_key
PAYU_MERCHANT_SALT=your_production_payu_salt

# Rate Limiting (Security)
RATE_LIMIT_MAX=300
